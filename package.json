{
  "name": "teamspeak-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n gateway,web -c blue,green \"npm run dev:gateway\" \"npm run dev:web\"",
    "dev:web": "vite",
    "dev:gateway": "tsx watch gateway/src/index.ts",
    "build": "npm run build:web",
    "build:web": "vite build",
    "start": "tsx gateway/src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p gateway/tsconfig.json --noEmit",
    "test": "npm run typecheck && npm run lint && npm run test:unit",
    "smoke:ws": "node scripts/smoke-ws.mjs",
    "smoke:ts3": "node --import tsx scripts/smoke-ts3-connect.ts",
    "smoke:voice": "node --import tsx scripts/smoke-voice-frame.mjs",
    "lint": "eslint .",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@honeybbq/teamspeak-client": "^0.2.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "simple-rnnoise-wasm": "^1.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-react": "^4.4.0",
    "@vitest/coverage-v8": "^5.0.0",
    "concurrently": "^9.1.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.3.0",
    "vitest": "^5.0.0"
  }
}
