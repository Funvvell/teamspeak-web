# TeamSpeak Web gateway env (example)
# Copy to .env and fill in real values. Do not commit .env.

# Required for PROTOCOL=ts3
GATEWAY_TOKEN=

# Voice server defaults (prefills login form when authorized)
DEFAULT_HOST=
DEFAULT_PORT=9987
DEFAULT_NICKNAME=

# ServerQuery admin (permissions / channel inspector). Credentials stay on gateway only.
# Leave SQ_USERNAME/SQ_PASSWORD empty to disable real ServerQuery; mock still works.
SQ_HOST=
SQ_PORT=10011
SQ_USERNAME=
SQ_PASSWORD=
SQ_SERVER_ID=0
PERMISSIONS_ENABLED=1

# Server bookmark catalog file (gateway-side JSON)
CATALOG_PATH=

# Optional
# MUSIC_BOT_URL=
# ALLOWED_HOSTS=
# ALLOW_PRIVATE_HOSTS=1
