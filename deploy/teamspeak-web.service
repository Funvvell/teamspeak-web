[Unit]
Description=TeamSpeak Web Gateway
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/teamspeak-web
Environment=NODE_ENV=production
Environment=PORT=8080
Environment=HOST=0.0.0.0
Environment=PROTOCOL=ts3
Environment=ALLOW_PRIVATE_HOSTS=0
# Secrets live in EnvironmentFile — do NOT put GATEWAY_TOKEN in this unit.
# Create /etc/teamspeak-web/env (chmod 600, owner www-data) with at least:
#   GATEWAY_TOKEN=<long random>
# Optional: DEFAULT_HOST, ALLOWED_HOSTS, ALLOWED_ORIGINS, MUSIC_BOT_URL
EnvironmentFile=-/etc/teamspeak-web/env
ExecStart=/usr/bin/node /opt/teamspeak-web/node_modules/tsx/dist/cli.mjs gateway/src/index.ts
Restart=on-failure
RestartSec=3
User=www-data
Group=www-data

[Install]
WantedBy=multi-user.target
