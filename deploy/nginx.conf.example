# Example: nginx reverse proxy + HTTPS (Let's Encrypt)
# Replace teamspeak.example.com with your domain.
# Microphone / getUserMedia requires a secure context (HTTPS).
#
# Rate limiting (define in http{} context, not here):
#   limit_req_zone $binary_remote_addr zone=tsweb:10m rate=10r/s;
#   limit_conn_zone $binary_remote_addr zone=tsweb_conn:10m;

server {
    listen 80;
    server_name teamspeak.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name teamspeak.example.com;

    ssl_certificate     /etc/letsencrypt/live/teamspeak.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/teamspeak.example.com/privkey.pem;

    client_max_body_size 8m;

    # Security headers (adjust if you add other frontends)
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Permissions-Policy "camera=(), microphone=(self), geolocation=()" always;
    # add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Rate-limit static/config abuse at the edge
        # limit_req zone=tsweb burst=20 nodelay;
        # limit_conn tsweb_conn 20;
    }

    location /ws {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        # Prefer Authorization: Bearer over query tokens (query tokens land in access logs)
        # limit_conn tsweb_conn 10;
    }
}
